# Copy this file to .env.local and fill it in. .env.local is never committed.
# Supabase dashboard: Project Settings > API (URL, publishable key, secret key) and Connect > Session pooler (database URL).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only. Never put these in the browser or share them in chat.
SUPABASE_SECRET_KEY=sb_secret_...
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Optional: switch the map to MapTiler (or any style URL). Without these the free Esri demo map is used.
# NEXT_PUBLIC_MAP_STYLE_LIGHT=
# NEXT_PUBLIC_MAP_STYLE_DARK=
